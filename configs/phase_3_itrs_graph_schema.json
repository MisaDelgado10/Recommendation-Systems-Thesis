      "expected_directed_edges": 94818
    },
    "acquisition_only_ablation": {
      "relations": "acquired | acquired_by",
      "expected_directed_edges": 64000
    }
  },
  "expected_counts": {
    "investor_nodes": 165975,
    "startup_nodes": 311589,
    "total_role_nodes": 477564,
    "shared_founder_directed_edges": 94818,
